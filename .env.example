# Copy to .env and adjust. Every value below is the default; none of them are secrets.

# ---------- Call service ----------
# Pipeline behind the Pipeline protocol: mock | open_weight
PIPELINE_BACKEND=mock
# Where the pipeline lives (docker compose overrides this to http://mock:8081)
PIPELINE_URL=http://localhost:8081
# Connection pool to the pipeline; oversizing it costs CPU at peak (see service/config.py)
HTTP_MAX_CONNECTIONS=50

# Where calls and dead letters are recorded: sqlite | dynamodb, and sqlite | sqs.
# Locally keep sqlite; Terraform sets dynamodb/sqs on AWS (several tasks share them).
CALL_LOG_BACKEND=sqlite
DLQ_BACKEND=sqlite
# AWS backends only. Credentials come from the ECS task role (or your AWS profile).
AWS_REGION=ap-south-1
CALL_LOG_TABLE=steadfast-call-log
DEAD_LETTERS_TABLE=steadfast-dead-letters
# Required when DLQ_BACKEND=sqs (Terraform output dlq_queue_url)
SQS_QUEUE_URL=

# SQLite file for call_log and dead_letters
DB_PATH=./data/steadfast.db
# FULL = fsync every commit (persist-before-ack); NORMAL = faster, may lose the last
# commits on power loss
DB_SYNCHRONOUS=FULL

# Retry policy
MAX_ATTEMPTS=3
BACKOFF_BASE_S=0.2
BACKOFF_CAP_S=2.0
ATTEMPT_TIMEOUT_S=2.5
CALL_DEADLINE_S=8.0

# Circuit breaker (rolling window of attempts)
BREAKER_WINDOW=100
BREAKER_MIN_CALLS=100
BREAKER_FAILURE_THRESHOLD=0.5
BREAKER_OPEN_S=10
BREAKER_HALF_OPEN_MAX=3

# Pipeline turns per call (1 = one pipeline request per call event, as in the spec)
TURNS_PER_CALL=1
TURN_GAP_S=0

# Seed for business-outcome sampling (leave empty for random)
OUTCOME_SEED=

SHUTDOWN_DRAIN_S=15
LOG_LEVEL=INFO

# Metrics: prometheus (GET /metrics, local) | emf (CloudWatch Embedded Metric Format log
# lines, namespace CollectionsChallenge; Terraform sets emf on AWS)
METRICS_BACKEND=prometheus
# EMF ServiceName dimension, and how often each task publishes InFlightCalls/CircuitOpen
SERVICE_NAME=steadfast-orchestrator
GAUGE_INTERVAL_S=10

# Replay worker (python -m service.replay_worker, AWS/SQS only): total replays started
# per second, split across this many parallel receive loops
REPLAY_RATE_PER_S=5
REPLAY_CONCURRENCY=8

# ---------- Mock pipeline ----------
FAILURE_RATE=0.2
LATENCY_MU=5.7
LATENCY_SIGMA=0.66
# Optional seed for reproducible mock behaviour
SEED=
# independent | burst
FAILURE_MODE=independent
BURST_ON_S=15
BURST_OFF_S=45

# ---------- CLI / load generator ----------
STEADFAST_URL=http://localhost:8080
# AWS only (eval "$(scripts/aws_env.sh)" sets both): value for the x-steadfast-key header,
# and the ALB's self-signed certificate to trust for HTTPS
STEADFAST_API_KEY=
STEADFAST_CA_BUNDLE=

# ---------- AWS deploy scripts (scripts/deploy.sh) ----------
# Which AWS credentials to use, e.g. a named profile from ~/.aws/config
# AWS_PROFILE=
# Image tag to deploy (default: git short SHA)
# IMAGE_TAG=
# AUTO_APPROVE=1 skips terraform's confirmation prompt
# AUTO_APPROVE=
# BUILD_NETWORK=host if pip downloads inside docker builds are very slow
# BUILD_NETWORK=
# Optional email for alarm and budget notifications (Terraform variable alert_email).
# Keep it in your shell or .env, never in a committed file.
# TF_VAR_alert_email=
# scripts/replay_aws.sh: give up waiting for the DLQ to drain after this many seconds
# MAX_WAIT_S=1800
# scripts/aws_results.sh: minutes of CloudWatch metrics to export, ending now
# MINUTES=60
